# Private project configuration. Copy to .env and use permission 600.
# Credentials stay empty in this committed example.
ZAI_API_KEY=
# Preserve an already verified endpoint, including an authorized Coding endpoint.
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3-flash
BLOCKFROST_API_KEY_PREPROD=

# Non-secret settings. Fill IDs from returned records, not examples.
COWORKER_ID=
VENDOR_ID=
EVE_URL=http://127.0.0.1:2000
MPS_DIR=
# Generated MPS secrets live in .local/mps.env.
# Scoped MPS token lives in .local/mps-runtime.env.
# Coworker runtime key stays in the CLI vault.

# Keep the Eve URL and port consistent.
EVE_PORT=2000
AGENT_API_PORT=3013
MPS_PORT=3012
# Choose a project-specific dedicated database name during setup.
MPS_DATABASE=
